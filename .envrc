# Repo-local environment, loaded automatically by direnv when you `cd` here.
# Requires direnv's shell hook (https://direnv.net/docs/hook.html).
# Nothing global is changed here.

# Wallet used by the repo-local `zdev` command.
# Absolute path so it keeps working from subdirectories and in `direnv exec`.
export WALLET="$PWD/.wallet"

# Make the repo-local `zdev` shim available. It is POSIX sh, so the same
# command works in bash, zsh, fish, and sh (no per-shell alias needed).
PATH_add bin

# Shell completions are installed user-wide (fish, bash, zsh, PowerShell,
# Elvish) rather than generated per-enter. Install them once with:
#   scripts/install-completions.sh
